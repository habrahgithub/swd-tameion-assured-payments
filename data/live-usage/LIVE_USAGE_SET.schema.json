{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tameion:withdrawn-public-source-set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "notice",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "WITHDRAWN_PRIVACY"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "maxItems": 0
    }
  }
}
